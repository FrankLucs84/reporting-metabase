# Configurazione per l'ambiente locale con SQL Server installato su Windows.
# Copiare in .env (stessa cartella) e sostituire le password. Il file .env NON va committato.
METABASE_VERSION=v0.56.6
METABASE_PORT=3000

# Database interno di Metabase (dove salva domande e dashboard)
MB_APPDB_PASSWORD=cambiami-appdb

# Usati da scripts/deploy.py
MB_TARGET=sqlserver
MB_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=Cambiami-Admin-2026!

# SQL Server visto dal container Metabase (il PC Windows) e utente in sola lettura
MB_WAREHOUSE_HOST=host.docker.internal
MB_WAREHOUSE_PORT=1433
WAREHOUSE_RO_PASSWORD=Cambiami-Metabase-2026!
