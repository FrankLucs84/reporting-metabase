# Copiare in .env e sostituire i valori. Il file .env NON va committato.
METABASE_VERSION=v0.56.6
METABASE_PORT=3000
WAREHOUSE_PORT=5433

# Warehouse (PostgreSQL con star schema Contoso)
WAREHOUSE_ADMIN_USER=contoso_admin
WAREHOUSE_ADMIN_PASSWORD=cambiami-admin
# Utente in sola lettura usato da Metabase
WAREHOUSE_RO_PASSWORD=cambiami-ro

# Database applicativo di Metabase
MB_APPDB_PASSWORD=cambiami-appdb

# Usati da scripts/deploy.py
MB_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=Cambiami-Admin-2026!
# Host del warehouse visto DAL CONTAINER Metabase (nome del servizio compose)
MB_WAREHOUSE_HOST=warehouse
MB_WAREHOUSE_PORT=5432
